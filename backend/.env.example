# Copy these into your environment (or export them) if you want to change defaults.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: SQLite by default. For MySQL set DB_ENGINE=mysql and the values below.
# DB_ENGINE=mysql
# DB_NAME=portfolio
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
